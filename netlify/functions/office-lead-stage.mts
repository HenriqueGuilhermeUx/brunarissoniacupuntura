import { getStore } from "@netlify/blobs";
import { createHmac } from "node:crypto";
const sig=(v:string,s:string)=>createHmac("sha256",s).update(v).digest("hex");
function allowed(req:Request){const secret=Netlify.env.get("BRUNA_OFFICE_SESSION_SECRET");const p=(req.headers.get("cookie")||"").split(";").map(v=>v.trim()).find(v=>v.startsWith("bruna_office_session="));const [e,s]=(p?p.substring(21):"").split(".");return Boolean(secret&&e&&s&&Number(e)>Date.now()&&sig(e,secret)===s)}
export default async(req:Request)=>{if(!allowed(req))return new Response("Unauthorized",{status:401});if(req.method!=="POST")return new Response("Method not allowed",{status:405});const body=await req.json().catch(()=>({}));const id=String(body.id||"");const stage=String(body.stage||"");const stages=["lead","contact","scheduled","attended","patient"];if(!id||!stages.includes(stage))return new Response("Invalid",{status:400});const store=getStore("bruna-leads",{consistency:"strong"});const key="lead/"+id;const lead=await store.get(key,{type:"json"});if(!lead)return new Response("Not found",{status:404});lead.stage=stage;lead.updatedAt=new Date().toISOString();await store.setJSON(key,lead);return Response.json({ok:true,lead});};